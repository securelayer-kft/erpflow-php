{
  "name": "erpflow/erpflow-php",
  "description": "Official PHP SDK for the ERPFlow Public API v3",
  "type": "library",
  "license": "MIT",
  "homepage": "https://erpflow.hu",
  "keywords": [
    "erpflow",
    "erp",
    "invoice",
    "billing",
    "api",
    "sdk"
  ],
  "support": {
    "source": "https://github.com/securelayer-kft/erpflow-php",
    "issues": "https://github.com/securelayer-kft/erpflow-php/issues"
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "autoload": {
    "psr-4": {
      "ERPFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ERPFlow\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": [
      "@php tests/smoke.php",
      "@php tests/contract.php"
    ]
  }
}
